{
  "name": "@dsh-external/dsh-render-perf",
  "version": "0.1.0",
  "description": "DSH Web 公式渲染性能治理：运行时注入公式渲染结果缓存（不修改安装目录）+ 视口外渲染跳过",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "author": "wendou-chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wendou-chen/dsh-render-perf.git"
  },
  "homepage": "https://github.com/wendou-chen/dsh-render-perf#readme",
  "bugs": {
    "url": "https://github.com/wendou-chen/dsh-render-perf/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "performance",
    "katex",
    "formula",
    "render",
    "enhancement-plugin"
  ],
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.14"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/verify-patch.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
